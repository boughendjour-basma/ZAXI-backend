# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (PostgreSQL URL - Supabase, Neon, Render, or Self-hosted)
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"

# JWT Authentication (generate a secure random 32+ character string)
JWT_SECRET="generate-a-secure-random-32-byte-secret-key"
JWT_EXPIRES_IN="7d"

# Frontend / Allowed CORS Origins (comma-separated if multiple, e.g. Vercel + custom domain)
CLIENT_URL="https://your-frontend-domain.vercel.app"
CORS_ORIGINS="https://your-frontend-domain.vercel.app,http://localhost:5173"

