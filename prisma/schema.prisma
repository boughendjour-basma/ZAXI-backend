// Prisma schema for ZAXI local development (SQLite)
generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  CUSTOMER
  DRIVER
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  DRIVER_ARRIVING
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PricingType {
  CITY
  DISTANCE
}

enum AnnouncementCategory {
  AIRPORT
  BEACH
  TOUR
  SPECIAL_OFFER
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model PricingSettings {
  id               Int      @id @default(1)
  cityFlatFare     Int      @map("city_flat_fare")
  outsideRatePerKm Int      @map("outside_rate_per_km")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("pricing_settings")
}

model DriverSettings {
  id                   Int      @id @default(1)
  driverName           String   @map("driver_name")
  phoneNumber          String   @map("phone_number")
  whatsappNumber       String?  @map("whatsapp_number")
  profilePhoto         String?  @map("profile_photo")
  description          String?
  workingHours         String?  @map("working_hours")
  minimumFare          Int?     @map("minimum_fare")
  maxBookingDistanceKm Float?   @map("max_booking_distance_km")
  isOnline             Boolean  @default(false) @map("is_online")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("driver_settings")
}

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  passwordHash  String?   @map("password_hash")
  name          String?
  phone         String    @unique
  phoneVerified Boolean   @default(false) @map("phone_verified")
  dateOfBirth   DateTime? @map("date_of_birth")
  lastLoginAt   DateTime? @map("last_login_at")
  role          Role      @default(CUSTOMER)
  profilePhoto  String?   @map("profile_photo")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customerBookings  Booking[]          @relation("CustomerBookings")
  driverBookings    Booking[]          @relation("DriverBookings")
  announcements     Announcement[]
  favorites         FavoriteLocation[]
  ratingsGiven      Rating[]           @relation("CustomerRatings")
  ratingsReceived   Rating[]           @relation("DriverRatings")
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Announcement {
  id                  String               @id @default(uuid())
  driverId            String               @map("driver_id")
  title               String
  description         String
  category            AnnouncementCategory
  price               Int?
  image               String?              @map("image")
  departureLocation   String?              @map("departure_location")
  destinationLocation String?              @map("destination_location")
  availableDate       DateTime?            @map("available_date")
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  driver              User                 @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([isActive])
  @@index([driverId])
  @@map("announcements")
}

model Booking {
  id                   String        @id @default(uuid())
  status               BookingStatus @default(PENDING)
  pricingType          PricingType   @default(DISTANCE) @map("pricing_type")
  cityFlatFareUsed     Int?          @map("city_flat_fare_used")
  outsideRatePerKmUsed Int?          @map("outside_rate_per_km_used")

  pickupLatitude       Float         @map("pickup_latitude")
  pickupLongitude      Float         @map("pickup_longitude")
  destinationLatitude  Float         @map("destination_latitude")
  destinationLongitude Float         @map("destination_longitude")
  pickupAddress        String        @map("pickup_address")
  destinationAddress   String        @map("destination_address")

  distanceKm      Float        @map("distance_km")
  estimatedPrice  Int          @map("estimated_price")
  durationMinutes Int          @map("duration_minutes")
  scheduledAt     DateTime?    @map("scheduled_at")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  customerId     String        @map("customer_id")
  customer       User          @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)

  driverId       String?       @map("driver_id")
  driver         User?         @relation("DriverBookings", fields: [driverId], references: [id], onDelete: SetNull)

  driverLocation DriverLocation?
  payment        Payment?
  rating         Rating?

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

model DriverLocation {
  id        String   @id @default(uuid())
  bookingId String   @unique @map("booking_id")
  driverId  String   @map("driver_id")
  latitude  Float
  longitude Float
  heading   Float?
  speed     Float?
  accuracy  Float?
  updatedAt DateTime @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([updatedAt])
  @@map("driver_locations")
}

model Payment {
  id                   String        @id @default(uuid())
  bookingId            String        @unique @map("booking_id")
  amount               Int
  paymentMethod        PaymentMethod @map("payment_method")
  status               PaymentStatus @default(PENDING)
  paidAt               DateTime?     @map("paid_at")
  transactionReference String?       @map("transaction_reference")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([paymentMethod])
  @@index([paidAt])
  @@map("payments")
}

model FavoriteLocation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  address   String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("favorite_locations")
}

model Rating {
  id         String   @id @default(uuid())
  bookingId  String   @unique @map("booking_id")
  customerId String   @map("customer_id")
  driverId   String   @map("driver_id")
  score      Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer User    @relation("CustomerRatings", fields: [customerId], references: [id], onDelete: Cascade)
  driver   User    @relation("DriverRatings", fields: [driverId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([driverId])
  @@map("ratings")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
